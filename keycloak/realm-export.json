{
  "realm": "car-rental",
  "displayName": "Car Rental Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "loginTheme": "carrental-modern",

  "roles": {
    "realm": [
      {
        "name": "CLIENT",
        "description": "Utilisateur client : peut parcourir les véhicules et créer des réservations"
      },
      {
        "name": "ADMIN",
        "description": "Administrateur : gestion complète de la flotte et des réservations"
      },
      {
        "name": "AGENT",
        "description": "Agent : peut confirmer ou annuler les réservations"
      }
    ]
  },

  "clients": [
    {
      "clientId": "car-rental-frontend",
      "name": "Car Rental Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://frontend:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://frontend:3000"
      ]
    },
    {
      "clientId": "car-rental-gateway",
      "name": "Car Rental Gateway",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false
    }
  ],

  "users": [
    {
      "username": "admin",
      "email": "admin@carrental.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "CLIENT"]
    },
    {
      "username": "client1",
      "email": "client1@carrental.com",
      "firstName": "Jean",
      "lastName": "Dupont",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "client123",
          "temporary": false
        }
      ],
      "realmRoles": ["CLIENT"]
    },
    {
      "username": "agent1",
      "email": "agent1@carrental.com",
      "firstName": "Sara",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "agent123",
          "temporary": false
        }
      ],
      "realmRoles": ["AGENT"]
    }
  ]
}
