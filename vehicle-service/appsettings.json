{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-db;Port=5432;Database=vehicledb;Username=postgres;Password=postgres"
  },

  "Keycloak": {
    "Authority": "http://keycloak:8180/realms/car-rental",
    "ValidIssuer": "http://localhost:8180/realms/car-rental"
  },

  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": "5672",
    "Username": "guest",
    "Password": "guest"
  },

  "Eureka": {
    "Client": {
      "ServiceUrl": "http://eureka-server:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true
    },
    "Instance": {
      "AppName": "vehicle-service",
      "Port": 8082,
      "PreferIpAddress": true,
      "HealthCheckUrl": "http://vehicle-service:8082/actuator/health",
      "StatusPageUrl": "http://vehicle-service:8082/actuator/health"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
