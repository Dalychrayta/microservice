<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VehicleService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core + PostgreSQL : ORM pour interagir avec PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.5" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />

    <!-- RabbitMQ : pour consommer les events publiés par rental-service -->
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />

    <!-- Swagger : documentation automatique de l'API -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Eureka Client : pour s'enregistrer dans le serveur de découverte -->
    <PackageReference Include="Steeltoe.Discovery.Eureka" Version="3.2.8" />

    <!-- JWT Authentication : validation des tokens Keycloak -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.5" />

    <!-- Prometheus metrics endpoint for Grafana/Prometheus dashboards -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

</Project>
