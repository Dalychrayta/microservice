{
  "id": null,
  "uid": "rental-business",
  "title": "Car Rental - Rental API Focus",
  "tags": ["carrental", "rental", "business"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests by Rental Endpoint",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"rental-service\",uri=~\"/api/rentals.*\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Confirm/Cancel/Complete Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"rental-service\",uri=~\".*/confirm\"}[5m]))",
          "legendFormat": "confirm"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"rental-service\",uri=~\".*/cancel\"}[5m]))",
          "legendFormat": "cancel"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"rental-service\",uri=~\".*/complete\"}[5m]))",
          "legendFormat": "complete"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Client Reservation Creation Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"rental-service\",method=\"POST\",uri=~\"/api/rentals.*\"}[5m]))",
          "legendFormat": "create rental"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "4xx/5xx by Endpoint",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"rental-service\",status=~\"4..|5..\",uri=~\"/api/rentals.*\"}[5m]))",
          "legendFormat": "{{status}} {{uri}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Rental Endpoints (Total Requests)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"rental-service\",uri=~\"/api/rentals.*\"}[1h])))",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
